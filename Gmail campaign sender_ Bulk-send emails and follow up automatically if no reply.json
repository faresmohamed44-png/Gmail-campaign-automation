        "jsCode": "function extractPlaceholders(str) {\n  return [...str.matchAll(/\\{([a-zA-Z0-9_-]+)\\}/g)].map(match => match[1]);\n}\nconst allKeys = [...new Set($('Email sequence').first().json.emails.flatMap(email => extractPlaceholders(email.message)))];\nconst source = $('Get emails').item.json;\nitem.json.placeholders = {};\nfor (const key of allKeys) {\n  if (source[key] === undefined) throw new Error(\"Message placeholder '\" + key + \"' requires a column called '\" + key + \"' in the Google Sheet\");\n  item.json.placeholders[key] = source[key];\n}\nreturn item;"
