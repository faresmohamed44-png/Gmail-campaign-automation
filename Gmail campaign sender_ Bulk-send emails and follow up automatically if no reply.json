      "parameters": {
        "jsCode": "function decodePart(part) {\n  if (!part) return '';\n  if (part.body && part.body.data) return Buffer.from(part.body.data, 'base64').toString('utf8');\n  for (const child of part.parts || []) {\n    const decoded = decodePart(child);\n    if (decoded) return decoded;\n  }\n  return '';\n}\nfor (const item of $input.all()) {\n  for (const message of item.json.messages || []) {\n    if (!message.html) message.html = decodePart(message.payload);\n  }\n}\nreturn $input.all();"
      },
      "id": "db4b6481-5fdb-4bc3-a10f-b6ccfb5b0bf0",
      "name": "Decode messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2000,
        720
      ]
    },
    {
      "parameters": {
        "jsCode": "const bufferMins = 20;\nconst templates = $('Email sequence').first().json.emails;\nfunction nextSequenceNumber(messages, mailId, senderName) {\n  for (let i = 0; i < messages.length; i++) {\n    if (!messages[i].html) return -1;\n    const inCampaign = messages[i].html.includes(\"data-cam='\" + mailId + \"'\");\n    const validSequence = messages[i].html.includes(\"data-seq='\" + i + \"'\");\n    const fromUs = (messages[i].From || '').includes(senderName);\n    if (!(fromUs && inCampaign && validSequence)) return -1;\n  }\n  return messages.length;\n}\nfor (const item of $input.all()) {\n  const messages = item.json.messages || [];\n  const firstDate = messages[0] && messages[0].internalDate;\n  item.json.first_message_at = DateTime.fromMillis(Number(firstDate || 0));\n  item.json.days_since_first_message = DateTime.now().diff(item.json.first_message_at, 'days').days;\n  item.json.next_sequence_number = nextSequenceNumber(messages, $('Settings').first().json.mail_id, $('Settings').first().json.sender_name);\n  item.json.next_message_due = item.json.next_sequence_number > 0 && item.json.next_sequence_number < templates.length && templates[item.json.next_sequence_number].send_on_day <= item.json.days_since_first_message + (bufferMins / 60 / 24);\n}\nreturn $input.all();"
      },
